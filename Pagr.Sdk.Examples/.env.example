# Copy this file to `.env` (same directory) and fill in your own values.
# `.env` is gitignored — never commit real keys.
#
# Get your keys from Settings → API keys in the Pagr web app. The prefix picks
# the mode: `pagr_test_*` renders are watermarked and batches are capped at 10
# documents; `pagr_prod_*` renders for real and consumes credit.
#
# The examples search upward from the working directory for a `.env` file, so
# this also works if you put it at the repository root.

# Test key — used by most examples.
TEST_KEY_PUBLIC=pagr_test_your_key_here

# Production key — only needed by the 'validate' example, which compares
# test-key and production-key behaviour. Consumes real credit.
PROD_KEY_PUBLIC=pagr_prod_your_key_here

# Optional. Only the 'batch-async' example uses this, for the webhook callback
# it registers. Must be reachable by the Pagr server, so a public URL or a
# tunnel (ngrok, Cloudflare Tunnel) — not localhost.
#PAGR_WEBHOOK_URL=https://your-app.example/pagr/callback

# Optional. Defaults to the hosted Pagr API; set this only to target another
# instance, e.g. a local development server.
#PAGR_BASE_URL=https://api.pagr.eu
